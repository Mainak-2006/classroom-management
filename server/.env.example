# Server
PORT=3000

# PRODUCTION Postgres (from `prisma postgres link` or your connection string)
# Local dev + tests use `.env.test` instead (copy from `.env.test.example`).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT secrets - MUST be changed in production
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# CORS: comma-separated list of allowed origins (e.g. the mobile web build / admin panel).
# When unset/empty, CORS stays disabled (mobile native apps are not subject to CORS).
CORS_ORIGINS=

# Default admin seeding (set SEED_DEFAULT_ADMIN=false to disable)
SEED_DEFAULT_ADMIN=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123