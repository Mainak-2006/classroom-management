generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Admin {
  id          String    @id @default(cuid())
  firstName   String
  middleName  String?
  lastName    String
  email       String    @unique
  phone       String
  dateOfBirth DateTime
  gender      Gender
  department  String
  role        AdminRole @default(ADMIN)
  profileImage String?
  isActive    Boolean   @default(true)
  password    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([email])
}

model Teacher {
  id             String   @id @default(cuid())
  firstName      String
  middleName     String?
  lastName       String
  email          String   @unique
  phone          String
  dateOfBirth    DateTime
  gender         Gender
  employeeId     String   @unique
  department     String
  designation    String
  qualification  String
  specialization String?
  officeRoom     String?
  profileImage   String?
  isActive       Boolean  @default(true)
  password       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  courses        Course[]
  @@index([email])
}

model Student {
  id                 String             @id @default(cuid())
  firstName          String
  middleName         String?
  lastName           String
  email              String             @unique
  phone              String
  dateOfBirth        DateTime
  gender             Gender
  rollNumber         String             @unique
  registrationNumber String             @unique
  department         String
  semester           Int
  section            String?
  address            String?
  profileImage       String?
  guardianName       String?
  guardianPhone      String?
  isActive           Boolean            @default(true)
  password           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  courses            Course[]
  attendance         Attendance[]
  examSubmissions    ExamSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  @@index([email])
}

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  department  String
  semester    Int
  credits     Int
  isActive    Boolean  @default(true)
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  students    Student[]
  assignments Assignment[]
  exams       Exam[]
  attendance  Attendance[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([teacherId])
  @@index([department, semester])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, courseId, date])
  @@index([courseId, date])
  @@index([studentId, date])
}

model Assignment {
  id           String           @id @default(cuid())
  title        String
  description  String?
  courseId     String
  dueDate      DateTime
  totalMarks   Int
  instructions String?
  status       AssignmentStatus @default(DRAFT)
  isActive     Boolean          @default(true)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([courseId, status, dueDate])
}

model AssignmentSubmission {
  id          String     @id @default(cuid())
  assignmentId String
  studentId   String
  response    String
  submittedAt DateTime   @default(now())
  feedback    String?
  score       Int?
  gradedAt    DateTime?
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@index([assignmentId, submittedAt])
}

model Exam {
  id           String           @id @default(cuid())
  title        String
  description  String?
  courseId     String
  examDate     DateTime
  duration     Int
  totalMarks   Int
  instructions String?
  status       ExamStatus       @default(DRAFT)
  isActive     Boolean          @default(true)
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  ExamSubmission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ExamSubmission {
  id          String   @id @default(cuid())
  examId      String
  studentId   String
  score       Int
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([examId, studentId])
  @@index([studentId, submittedAt])
}

model AuthSession {
  id        String   @id
  userId    String
  role      String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RevokedAccessToken {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
