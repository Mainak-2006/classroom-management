# PRODUCTION API URL (deployed `server` app on Prisma Compute)
# Copy this file to `.env` (gitignored) and set the hosted API URL there.
# Loaded for production bundles (`expo export`, EAS production builds).
EXPO_PUBLIC_API_URL=https://<prod-app-id>.sin.prisma.build

# TEST API URL (deployed `server-test` app on Prisma Compute)
# Copy `.env.development.example` to `.env.development` and set the test URL.
# `.env.development` is loaded automatically by `npx expo start`
# (NODE_ENV=development) and takes priority over `.env`.
# EXPO_PUBLIC_API_URL=https://<test-app-id>.sin.prisma.build
