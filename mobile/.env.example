# Development API URL. Works for web (`npx expo start` + press `w`) and
# the iOS simulator. For a physical device, use your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.3:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Production API URL (when the server is deployed, e.g. to Prisma Compute):
# copy this file to `.env.production` and set the hosted API URL there.
# EXPO_PUBLIC_API_URL=https://<your-service>.compute.prisma.io
