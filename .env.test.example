# Server
PORT=3000

# LOCAL DEV & TEST Postgres (from `prisma postgres link` or your connection string)
# Copy this file to `.env.test` (gitignored) and fill in real values.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT secrets - MUST be changed beyond local use
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# Default admin seeding (set SEED_DEFAULT_ADMIN=false to disable)
SEED_DEFAULT_ADMIN=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123
